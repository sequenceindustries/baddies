// Baddies — Sprint 0 database schema
// PostgreSQL. See docs/architecture.md for design rationale.
//
// Design principles enforced here:
// - No business values hard-coded (see PlatformSetting)
// - Wallet balances are DERIVED from LedgerEntry, never mutated directly
// - Legal identity vs. public creator identity are separate concepts
// - Verification documents are referenced, never stored as raw blobs in DB
// - All money fields use Decimal, never float

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserRole {
  FAN
  CREATOR
  ADMIN
}

enum CreatorStatus {
  PENDING
  VERIFICATION_REQUIRED
  UNDER_REVIEW
  VERIFIED
  SUSPENDED
  REJECTED
  BANNED
}

// The Founding Baddies recruitment campaign's own pipeline — separate
// from CreatorStatus because an applicant here has no User account yet
// (see FoundingApplication's own comment). REJECTED isn't in the
// product brief's literal status list but is the minimum needed for
// the admin queue to actually close out a "no" the same way
// CreatorQueue's own Reject button does. CONTENT_READY sits between
// ONBOARDING and LIVE — onboarded and verified, content prepared, just
// waiting to flip live (see the Command Centre's Founding Baddies
// funnel, which reads "ready for launch" as this stage).
//
// Matches the MASTER REQUIREMENTS spec's pipeline exactly (§6):
// Applied -> Contact Confirmed -> Identity Submitted -> Verification
// Review -> Verified -> Approved -> Onboarding -> Content Ready -> Live,
// with Rejected possible at any stage. Suspended/Banned are deliberately
// NOT here — those apply once a Founding Baddie has a real User account
// (see CreatorStatus), not to the pre-account application record.
// Renamed from the previous 9-value set (REVIEWED, VERIFICATION_PENDING
// replaced by CONTACT_CONFIRMED, IDENTITY_SUBMITTED, VERIFICATION_REVIEW)
// via prisma/migrations/*_founding_application_pipeline_rework — checked
// production directly before renaming: zero rows used the two dropped
// values, so no data remapping was needed.
enum FoundingApplicationStatus {
  APPLIED
  CONTACT_CONFIRMED
  IDENTITY_SUBMITTED
  VERIFICATION_REVIEW
  VERIFIED
  APPROVED
  ONBOARDING
  CONTENT_READY
  LIVE
  REJECTED
}

// Per-channel identity-review status (MASTER REQUIREMENTS §5) — kept
// self-contained on Identity rather than routed through the generic
// VerificationSession model, which stays reserved for when a real
// automated KYC provider is plugged in later (§18); Identity's shape
// here already matches what such a provider would return.
enum IdentityStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  FAILED
  REJECTED
}

enum IdentityDocumentType {
  ID_DOCUMENT
  SELFIE
  ID_HOLDING_PHOTO
}

enum IdentityDocumentStatus {
  UPLOADED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  DELETED
}

// The one MASTER REQUIREMENTS rule marked non-negotiable (§1, §19.2):
// creator location is auto-detected server-side (see
// src/lib/security/geo.ts), never self-reported, and a non-South-African
// result is an immediate rejection, not a manual-review flag. This model
// is what makes that decision auditable after the fact — see
// src/app/api/founding/apply/route.ts for where it's written.
enum LocationStatus {
  PENDING
  SOUTH_AFRICA
  REJECTED
}

enum BankingStatus {
  NOT_SUBMITTED
  SUBMITTED
  EXTERNALLY_VERIFIED
  FAILED
  NEEDS_CORRECTION
}

enum BankAccountType {
  SAVINGS
  CHEQUE
  TRANSMISSION
  OTHER
}

// MASTER REQUIREMENTS §4 — AGE_DECLARATION deliberately excluded, see
// the Agreement model's own comment.
enum AgreementType {
  CREATOR_TERMS
  CONTENT_POLICY
  PRIVACY_POLICY
  PAYOUT_AGREEMENT
}

enum VerificationType {
  IDENTITY
  AGE
  LIVENESS
  PARTICIPANT
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  EXPIRED
  MANUAL_REVIEW
}

// Tier model (renamed from PUBLIC_PREVIEW/ENTRY/VIP — see
// prisma/migrations/*_rename_tier_model for the rename mapping):
//   FREE  — visible to everyone, no login required
//   VIP   — unlocked by the platform-wide VIP pass (UnlimitedSubscription;
//           model name kept to avoid a bigger rename) from ANY
//           participating creator, or by that creator's own VVIP
//           subscribers
//   VVIP  — unlocked only by that specific creator's own subscribers
//           (Subscription model — single tier now, see SubscriptionTier's
//           removal below)
// PPV (pay-per-view single-item purchase) was retired from the product.
// The enum value is deliberately left in place rather than dropped —
// Postgres has no safe way to remove one value from an enum type without
// recreating it, and no code path can create PPV content anymore.
enum ContentAccessLevel {
  FREE
  VIP
  VVIP
  PPV
}

enum ContentStatus {
  DRAFT
  UPLOADED
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  REMOVED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
  REFUNDED
}

enum LedgerEventType {
  SUBSCRIPTION
  PPV
  TIP
  MESSAGE
  UNLIMITED_ALLOCATION
  REFUND
  CHARGEBACK
  PLATFORM_FEE
  PAYMENT_FEE
  PAYOUT
  PAYOUT_REVERSAL
  ADJUSTMENT
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  FAILED
  REVERSED
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  ESCALATED
  UPHELD
  APPEALED
  RESOLVED
  DISMISSED
}

enum ReportReason {
  NON_CONSENSUAL
  MINOR_SAFETY
  ILLEGAL_CONTENT
  IMPERSONATION
  HARASSMENT
  SPAM
  OTHER
}

enum ConsentStatus {
  PENDING
  CONFIRMED
  REVOKED
  DISPUTED
}

enum TrialStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

// =========================================================================
// IDENTITY & ACCESS
// =========================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  role          UserRole  @default(FAN)

  ageVerified       Boolean   @default(false)
  ageVerifiedAt     DateTime?
  ageVerificationId String? // FK-ish reference to VerificationSession, resolved via app layer

  isActive    Boolean   @default(true)
  suspendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile              Profile?
  creatorProfile       CreatorProfile?
  wallet               Wallet?
  sentMessages         Message[]               @relation("MessageSender")
  reportsFiled         Report[]                @relation("ReportReporter")
  auditLogs            AuditLog[]
  sessions             Session[]
  notifications        Notification[]
  purchases            Purchase[]
  tips                 Tip[]                   @relation("TipSender")
  subscriptions        Subscription[]          @relation("FanSubscriptions")
  unlimitedSubs        UnlimitedSubscription[]
  follows              Follow[]                @relation("FanFollows")
  contentLikes         ContentLike[]           @relation("ContentLikes")
  // Not yet exercised by any route (Phase 3 only ever writes the
  // FoundingApplication side of AgreementAcceptance) — modeled now so a
  // real User re-accepting an updated agreement later needs no migration.
  agreementAcceptances AgreementAcceptance[]
  fanTrial             FanTrial?

  @@index([role])
  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

// Public-facing profile — safe to display. Separate from legal identity.
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  avatarUrl   String?
  bio         String?
  // Nullable at the DB level (existing rows predate this field, and a
  // NOT NULL migration would need a backfill for data we don't have) —
  // required going forward at the application layer instead: both are
  // mandatory on registration and on any profile edit. See
  // RegisterSchema in src/app/api/auth/register/route.ts and
  // UpdateProfileSchema in src/app/api/profile/route.ts.
  country     String?
  city        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

// =========================================================================
// CREATORS & VERIFICATION
// =========================================================================

model CreatorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status CreatorStatus @default(PENDING)

  // Public identity (stage name etc.) lives on Profile.
  // Legal identity is intentionally NOT stored here in plaintext —
  // see VerificationSession.providerReference, which points to
  // provider-hosted records rather than raw documents.
  legalNameEncrypted String? // encrypted at rest; never returned to clients directly

  coverImageUrl     String?
  vvipPriceOverride Decimal? @db.Decimal(10, 2) // this creator's own subscription price; null = use PlatformSetting default
  unlimitedOptedIn  Boolean  @default(false) // opts this creator's VIP-tier content into the platform-wide VIP pass

  subscriberCountVisible Boolean @default(false)
  locationVisible        Boolean @default(false)

  // "Live videos" (an Exclusive-subscription benefit) — a status flag a
  // creator toggles, not a video transport. There is no real streaming
  // pipeline behind this (that needs a WebRTC/media-server provider —
  // LiveKit, Agora, etc. — with real credentials this project doesn't
  // have), so it's deliberately just "is this creator live right now,"
  // shown as a badge. Upgrading it to actual video later only needs a
  // player wired to isLive, not a data model change.
  isLive        Boolean   @default(false)
  liveStartedAt DateTime?

  appliedAt  DateTime  @default(now())
  approvedAt DateTime?
  approvedBy String? // admin User.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications VerificationSession[]
  content       Content[]
  ledgerEntries LedgerEntry[]
  followers     Follow[]
  categories    CreatorCategory[]

  @@index([status])
  @@map("creator_profiles")
}

// Generic verification session — covers creator identity/age/liveness
// AND third-party content participants. Provider-agnostic by design;
// see src/lib/providers/verification.ts for the interface this backs.
model VerificationSession {
  id     String             @id @default(cuid())
  type   VerificationType
  status VerificationStatus @default(NOT_STARTED)

  // Polymorphic-ish: exactly one of these should be set.
  creatorProfileId          String?
  creatorProfile            CreatorProfile?          @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  verificationParticipantId String?
  verificationParticipant   VerificationParticipant? @relation(fields: [verificationParticipantId], references: [id], onDelete: Cascade)

  provider          String // e.g. "stub", set via VERIFICATION_PROVIDER
  providerSessionId String? // opaque reference into provider's system
  providerReference String? // e.g. hosted-document URL/ID; never a raw file blob

  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  expiresAt     DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorProfileId])
  @@index([verificationParticipantId])
  @@index([status])
  @@map("verification_sessions")
}

// A person appearing in content who is not necessarily a Baddies user
// (e.g. a collaborator). Verification + consent tracked independently
// of the uploading creator's own verification.
model VerificationParticipant {
  id                 String             @id @default(cuid())
  legalNameEncrypted String?
  status             VerificationStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications       VerificationSession[]
  consentRecords      ConsentRecord[]
  contentParticipants ContentParticipant[]

  @@map("verification_participants")
}

model ConsentRecord {
  id                        String                  @id @default(cuid())
  verificationParticipantId String
  verificationParticipant   VerificationParticipant @relation(fields: [verificationParticipantId], references: [id], onDelete: Cascade)

  status       ConsentStatus @default(PENDING)
  documentRef  String? // pointer to provider-hosted consent doc, not raw storage
  recordedById String? // admin/staff User.id who logged this, if applicable
  effectiveAt  DateTime?
  revokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationParticipantId])
  @@map("consent_records")
}

// =========================================================================
// DISCOVERY (Sprint 3) — kept intentionally minimal per build brief §13/§35
// =========================================================================

// A fan following a creator. Drives the "Creators the fan follows" section
// of Fan Home (§13, priority #1) and the "Following" discovery tab (§11).
model Follow {
  id               String         @id @default(cuid())
  fanId            String
  fan              User           @relation("FanFollows", fields: [fanId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([fanId, creatorProfileId])
  @@index([creatorProfileId])
  @@map("follows")
}

// A fan liking a piece of content — social-proof signal only, grants no
// access (see ContentAccessLevel for what actually gates viewing).
model ContentLike {
  id        String   @id @default(cuid())
  fanId     String
  fan       User     @relation("ContentLikes", fields: [fanId], references: [id], onDelete: Cascade)
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fanId, contentId])
  @@index([contentId])
  @@map("content_likes")
}

// Flat, admin-managed category list (§11: "Categories"). Deliberately not
// a hierarchy/taxonomy system — build brief §31 excludes "general creator
// categories" complexity and §35 says push out anything that doesn't
// clearly serve acquisition/trust/revenue/function.
model Category {
  id   String @id @default(cuid())
  slug String @unique
  name String

  creators CreatorCategory[]

  @@map("categories")
}

model CreatorCategory {
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([creatorProfileId, categoryId])
  @@index([categoryId])
  @@map("creator_categories")
}

// =========================================================================
// PLATFORM CONFIGURATION (no hard-coded business rules)
// =========================================================================

model PlatformSetting {
  key         String   @id
  value       String // stored as string, parsed by consumer per zod schema
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String? // admin User.id

  @@map("platform_settings")
}

// =========================================================================
// CONTENT
// =========================================================================

model Content {
  id               String         @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  mediaType   MediaType
  accessLevel ContentAccessLevel
  priceUsd    Decimal?           @db.Decimal(10, 2) // required when accessLevel = PPV
  caption     String?

  status           ContentStatus @default(DRAFT)
  moderationStatus ContentStatus @default(DRAFT)
  contentHash      String? // dedup / provenance

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mediaAssets       MediaAsset[]
  participants      ContentParticipant[]
  entitlements      ContentEntitlement[]
  purchases         Purchase[]
  reports           Report[]
  moderationCases   ModerationCase[]
  consumptionEvents QualifiedConsumptionEvent[]
  likes             ContentLike[]

  @@index([creatorProfileId, status])
  @@index([accessLevel])
  @@map("content")
}

model ContentParticipant {
  id                        String                  @id @default(cuid())
  contentId                 String
  content                   Content                 @relation(fields: [contentId], references: [id], onDelete: Cascade)
  verificationParticipantId String
  verificationParticipant   VerificationParticipant @relation(fields: [verificationParticipantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([contentId, verificationParticipantId])
  @@map("content_participants")
}

// Private storage reference only — never a public permanent URL.
// Access is always mediated by signed URLs at request time.
model MediaAsset {
  id              String   @id @default(cuid())
  contentId       String
  content         Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  storageProvider String
  storageKey      String // private bucket key, never a public URL
  mimeType        String
  byteSize        Int?
  durationSeconds Int?
  createdAt       DateTime @default(now())

  @@index([contentId])
  @@map("media_assets")
}

// Backing store for the "stub" MediaStorageProvider only (see
// src/lib/providers/storage/stub.ts) — holds actual bytes in Postgres so
// content survives across process boundaries. This matters specifically
// because Railway's preDeployCommand (migrate + seed) runs in a separate,
// throwaway container from the one that ends up serving requests: local
// disk written during seeding would vanish before the app ever started.
// A real provider (S3 etc.) would never touch this table.
model MediaBlob {
  storageKey String   @id
  mimeType   String
  bytes      Bytes
  createdAt  DateTime @default(now())

  @@map("media_blobs")
}

// =========================================================================
// ENTITLEMENTS & SUBSCRIPTIONS
// =========================================================================

// A fan's VVIP subscription to one specific creator — single tier, no
// tier field: previously ENTRY/VIP, collapsed to one creator-level tier
// (see ContentAccessLevel's comment for the full tier model).
model Subscription {
  id               String             @id @default(cuid())
  fanId            String
  fan              User               @relation("FanSubscriptions", fields: [fanId], references: [id], onDelete: Cascade)
  creatorProfileId String
  status           SubscriptionStatus @default(ACTIVE)

  priceUsdAtPurchase Decimal @db.Decimal(10, 2)

  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  gracePeriodEnd   DateTime?

  paymentProviderSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fanId, creatorProfileId])
  @@index([status])
  @@map("subscriptions")
}

model UnlimitedSubscription {
  id     String             @id @default(cuid())
  fanId  String
  fan    User               @relation(fields: [fanId], references: [id], onDelete: Cascade)
  status SubscriptionStatus @default(ACTIVE)

  priceUsdAtPurchase Decimal @db.Decimal(10, 2)

  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?

  paymentProviderSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fanId])
  @@index([status])
  @@map("unlimited_subscriptions")
}

// MASTER REQUIREMENTS §11 — one 24-hour trial per fan, ever (prevents
// trivial re-trial abuse; the spec frames this as a one-time
// acquisition hook, not a repeatable perk). Grants temporary access to
// VIP-tier content platform-wide (see src/lib/entitlements/content.ts
// and its own comment on why FREE/VVIP are excluded) without requiring
// the VIP pass or any VVIP subscription. Lazily expired, not
// cron-driven — no job-queue system exists in this codebase — so
// `status` is authoritative for admin display only; every real access
// check independently compares `expiresAt` to now() via
// src/lib/entitlements/trial.ts's isTrialActive(), same pattern
// Subscription/UnlimitedSubscription already use alongside their own
// `status` field.
model FanTrial {
  id          String      @id @default(cuid())
  fanId       String      @unique
  fan         User        @relation(fields: [fanId], references: [id], onDelete: Cascade)
  status      TrialStatus @default(ACTIVE)
  startedAt   DateTime    @default(now())
  expiresAt   DateTime
  convertedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("fan_trials")
}

// Derived-access cache: recomputed by the entitlement engine, not
// hand-edited. Kept so reads don't need to replay subscription logic
// on every content request.
model ContentEntitlement {
  id        String    @id @default(cuid())
  fanId     String
  contentId String
  content   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  source    String // e.g. "subscription:<id>", "ppv:<purchaseId>", "unlimited:<id>"
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@unique([fanId, contentId, source])
  @@index([fanId])
  @@map("content_entitlements")
}

model Purchase {
  id        String  @id @default(cuid())
  fanId     String
  fan       User    @relation(fields: [fanId], references: [id], onDelete: Cascade)
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  priceUsd Decimal @db.Decimal(10, 2)

  paymentProviderTransactionId String?
  refundedAt                   DateTime?

  createdAt DateTime @default(now())

  @@index([fanId])
  @@index([contentId])
  @@map("purchases")
}

model Tip {
  id               String @id @default(cuid())
  fanId            String
  fan              User   @relation("TipSender", fields: [fanId], references: [id], onDelete: Cascade)
  creatorProfileId String

  amountUsd Decimal @db.Decimal(10, 2)
  message   String?

  paymentProviderTransactionId String?

  createdAt DateTime @default(now())

  @@index([fanId])
  @@index([creatorProfileId])
  @@map("tips")
}

// Deliberately NOT satisfied by simple page views — see QualifiedConsumptionEvent
// eligibility rules in src/lib/entitlements/unlimited.ts
model QualifiedConsumptionEvent {
  id        String  @id @default(cuid())
  fanId     String
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  unlimitedSubscriptionId String

  durationSeconds Int? // e.g. watch time, for video
  qualifiesAt     DateTime @default(now())
  weight          Decimal  @default(1.0) @db.Decimal(6, 3) // input to allocation engine

  createdAt DateTime @default(now())

  @@index([fanId])
  @@index([contentId])
  @@index([unlimitedSubscriptionId])
  @@map("qualified_consumption_events")
}

// =========================================================================
// MESSAGING
// =========================================================================

model Message {
  id          String @id @default(cuid())
  senderId    String
  sender      User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  threadKey   String // stable key for a fan<->creator conversation

  body         String?
  mediaAssetId String?
  priceUsd     Decimal? @db.Decimal(10, 2) // set for paid messages (architecture only in V1)

  isModerated Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([threadKey])
  @@index([senderId])
  @@index([recipientId])
  @@map("messages")
}

// =========================================================================
// LEDGER & PAYOUTS — immutable, append-only
// =========================================================================

model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Balances are READ MODELS derived from LedgerEntry aggregation.
  // They may be cached here for performance but must be recomputable
  // from ledger_entries alone. Never write to these fields directly
  // outside of the ledger-reconciliation job.
  cachedPendingBalanceUsd   Decimal   @default(0) @db.Decimal(12, 2)
  cachedAvailableBalanceUsd Decimal   @default(0) @db.Decimal(12, 2)
  cachedPaidBalanceUsd      Decimal   @default(0) @db.Decimal(12, 2)
  balanceRecomputedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]
  payouts       Payout[]

  @@map("wallets")
}

model LedgerEntry {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  creatorProfileId String?
  creatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])

  type LedgerEventType

  // Gross amount for the event, in the original transaction currency.
  grossAmount     Decimal   @db.Decimal(12, 2)
  currency        String    @default("USD")
  fxRate          Decimal?  @db.Decimal(12, 6)
  fxTimestamp     DateTime?
  settledAmount   Decimal?  @db.Decimal(12, 2) // in settlement currency, once known
  settledCurrency String?

  // Split of gross amount — populated per PlatformSetting rules at write time,
  // never recomputed retroactively from a "current" percentage.
  creatorShareAmount  Decimal? @db.Decimal(12, 2)
  platformShareAmount Decimal? @db.Decimal(12, 2)
  paymentFeeAmount    Decimal? @db.Decimal(12, 2)

  referenceType String? // "subscription" | "purchase" | "tip" | "payout" | ...
  referenceId   String? // FK-ish pointer to the source record

  description String?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([creatorProfileId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

model Payout {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  amountUsd Decimal      @db.Decimal(12, 2)
  currency  String       @default("USD")
  status    PayoutStatus @default(REQUESTED)

  paymentProviderPayoutId String?
  requestedAt             DateTime  @default(now())
  processedAt             DateTime?
  failureReason           String?

  @@index([walletId])
  @@index([status])
  @@map("payouts")
}

// =========================================================================
// TRUST & SAFETY
// =========================================================================

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reporter       User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  contentId      String?
  content        Content? @relation(fields: [contentId], references: [id])
  reportedUserId String?

  reason  ReportReason
  details String?

  createdAt DateTime @default(now())

  moderationCase ModerationCase?

  @@index([contentId])
  @@index([reportedUserId])
  @@map("reports")
}

model ModerationCase {
  id        String   @id @default(cuid())
  contentId String?
  content   Content? @relation(fields: [contentId], references: [id])
  reportId  String?  @unique
  report    Report?  @relation(fields: [reportId], references: [id])

  status            ModerationCaseStatus @default(OPEN)
  assignedToAdminId String?
  resolutionNotes   String?

  escalated  Boolean   @default(false)
  appealedAt DateTime?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId])
  @@index([status])
  @@map("moderation_cases")
}

// =========================================================================
// NOTIFICATIONS, AUDIT
// =========================================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  payload Json?
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// =========================================================================
// FOUNDING BADDIES CAMPAIGN
// =========================================================================

// A prospective creator's application to the Founding Baddies launch
// campaign — deliberately NOT tied to a User row. The whole point of
// this form (see /founding-baddies) is that someone can apply before
// they have any Baddies account at all; once approved, they go through
// the existing /register -> /apply flow normally, with the same email.
// Kept flat and mostly free-text on purpose — this is a recruitment
// form, not a KYC form (no identity documents collected here; that
// still only ever happens through the real VerificationSession flow
// once they're a real creator).
model FoundingApplication {
  id String @id @default(cuid())

  fullName  String
  stageName String
  email     String
  phone     String
  country   String
  city      String

  // [{ category: "social"|"creator", platform: string, handle: string,
  //    link: string, followers: string }, ...] — one entry per platform
  // the applicant checked, "platform" holding their own label when they
  // picked "Other". A JSON column instead of a child table because this
  // is a write-once submission, never queried or edited field-by-field.
  platforms Json

  audienceSize           String? // free-text total, e.g. "~50k across platforms"
  monetisationExperience String?
  creatingSince          String?
  currentlyMonetising    Boolean?
  whyJoinBaddies         String

  confirmsAdult        Boolean
  agreesToVerification Boolean

  status     FoundingApplicationStatus @default(APPLIED)
  adminNotes String?
  reviewedBy String? // admin User.id
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // MASTER REQUIREMENTS data-architecture entities (§7) — each attaches
  // 1:1 (or 1:N for documents) directly to the application record rather
  // than polymorphically like VerificationSession, because a Founding
  // Baddie has no User row yet (see this model's own comment above).
  identity             Identity?
  contact              Contact?
  agreementAcceptances AgreementAcceptance[]
  location             Location?
  banking              Banking?
  documents            IdentityDocument[]

  @@index([status])
  @@index([email])
  @@map("founding_applications")
}

// Legal/biographical identity + review state for a Founding Baddie
// applicant (MASTER REQUIREMENTS §5, §7). idNumberEncrypted uses the
// same encryptField()/decryptField() as CreatorProfile.legalNameEncrypted
// (see src/lib/security/field-encryption.ts) — no new crypto code.
model Identity {
  id                    String              @id @default(cuid())
  foundingApplicationId String              @unique
  foundingApplication   FoundingApplication @relation(fields: [foundingApplicationId], references: [id], onDelete: Cascade)

  legalName         String
  dateOfBirth       DateTime @db.Date
  nationality       String
  idNumberEncrypted String

  status        IdentityStatus @default(NOT_SUBMITTED)
  submittedAt   DateTime?
  reviewedBy    String? // admin User.id
  reviewedAt    DateTime?
  failureReason String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("identities")
}

// Private file reference for ID documents / verification selfies / ID-
// holding photos — same pattern as MediaAsset (storageKey is an opaque,
// private key via getMediaStorageProvider(), never a public URL). One
// application can have several (resubmissions), so this is 1:N rather
// than living inline on Identity.
model IdentityDocument {
  id                    String              @id @default(cuid())
  foundingApplicationId String
  foundingApplication   FoundingApplication @relation(fields: [foundingApplicationId], references: [id], onDelete: Cascade)

  type            IdentityDocumentType
  storageProvider String
  storageKey      String
  mimeType        String

  status     IdentityDocumentStatus @default(UPLOADED)
  reviewedBy String? // admin User.id
  reviewedAt DateTime?
  uploadedAt DateTime               @default(now())
  deletedAt  DateTime?

  @@index([foundingApplicationId])
  @@map("identity_documents")
}

// Email/WhatsApp verification *state* only — email and phone themselves
// stay on FoundingApplication, unchanged. "Status" (Verified/Unverified)
// is deliberately derived from whether the *VerifiedAt timestamp is set
// rather than a redundant stored enum column, matching the spec's own
// 2-value lists (§5) with one less thing that can drift out of sync.
// whatsappMethod is a plain string, not an enum, on purpose — see
// src/lib/providers/whatsapp/ for why (Phase 2 can add a real OTP method
// later with no migration).
model Contact {
  id                    String              @id @default(cuid())
  foundingApplicationId String              @unique
  foundingApplication   FoundingApplication @relation(fields: [foundingApplicationId], references: [id], onDelete: Cascade)

  emailVerifiedAt DateTime?

  whatsappVerifiedAt DateTime?
  whatsappVerifiedBy String? // admin User.id who manually confirmed it
  whatsappMethod     String    @default("click_to_chat_manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("application_contacts")
}

// Server-detected location + the decision it produced — the audit trail
// behind the one MASTER REQUIREMENTS rule marked non-negotiable (§1,
// §19.2). Always written, on both the accept and reject path — see
// src/app/api/founding/apply/route.ts.
model Location {
  id                    String              @id @default(cuid())
  foundingApplicationId String              @unique
  foundingApplication   FoundingApplication @relation(fields: [foundingApplicationId], references: [id], onDelete: Cascade)

  detectedCountry    String? // ISO2, or null if detection failed entirely
  detectionSignal    String // "vercel-header" | "cloudflare-header" | "ip-geolocation" | "dev-bypass"
  detectionTimestamp DateTime       @default(now())
  status             LocationStatus
  rejectionReason    String?

  createdAt DateTime @default(now())

  @@index([status])
  @@map("locations")
}

// Banking details for payouts (MASTER REQUIREMENTS §3). Bank verification
// is handled externally in V1 (status/externalVerificationRef only — no
// verification logic here). accountNumberEncrypted uses the same
// encryptField() as Identity.idNumberEncrypted; the plaintext account
// number is never sent to any client — see src/lib/security/mask.ts.
model Banking {
  id                    String              @id @default(cuid())
  foundingApplicationId String              @unique
  foundingApplication   FoundingApplication @relation(fields: [foundingApplicationId], references: [id], onDelete: Cascade)

  bankName               String
  accountHolderName      String
  accountNumberEncrypted String
  accountType            BankAccountType
  branchCode             String

  status                  BankingStatus @default(NOT_SUBMITTED)
  externalVerificationRef String?
  verifiedAt              DateTime?
  adminNotes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("banking_details")
}

// Creator Terms / Content Policy / Privacy Policy / Payout Agreement
// (MASTER REQUIREMENTS §4). AGE_DECLARATION is deliberately not a type
// here — FoundingApplication.confirmsAdult already covers that, no
// reason to migrate a working boolean into this system. bodyText is
// full inline text, no separate CMS/route — rendered directly wherever
// an agreement needs to be shown (see
// src/app/founding-baddies/complete-onboarding/page.tsx).
//
// NOTE: seeded body text (see prisma/seed.ts) is placeholder, real but
// not lawyer-reviewed — each one says so in its own first line. Swap in
// real reviewed text as a new `version` row when ready; never edit an
// existing version's bodyText in place, since AgreementAcceptance rows
// point at a specific version and that link should stay meaningful.
model Agreement {
  id          String        @id @default(cuid())
  type        AgreementType
  version     String
  title       String
  bodyText    String
  effectiveAt DateTime      @default(now())

  acceptances AgreementAcceptance[]

  @@unique([type, version])
  @@map("agreements")
}

// Polymorphic like VerificationSession (exactly one of
// foundingApplicationId/userId set) — Phase 3 only ever writes the
// FoundingApplication side; userId exists for a real account
// re-accepting an updated agreement later, not built yet. ipAddress is
// always read server-side from the request (req.headers.get
// ("x-forwarded-for")), same as every other AuditLog/Session row —
// never client-supplied.
model AgreementAcceptance {
  id                    String               @id @default(cuid())
  agreementId           String
  agreement             Agreement            @relation(fields: [agreementId], references: [id])
  foundingApplicationId String?
  foundingApplication   FoundingApplication? @relation(fields: [foundingApplicationId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  acceptedAt DateTime @default(now())
  ipAddress  String?

  @@index([agreementId])
  @@index([foundingApplicationId])
  @@index([userId])
  @@map("agreement_acceptances")
}

// Append-only. Every sensitive admin / financial / moderation action
// should write one of these. Never update or delete rows here.
model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  action     String // e.g. "creator.approve", "content.remove", "payout.approve"
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
