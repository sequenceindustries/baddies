# ==== Core ====
NODE_ENV=development
APP_URL=http://localhost:3000

# ==== Database ====
DATABASE_URL=postgresql://baddies:baddies@localhost:5432/baddies_dev

# ==== Field-level encryption ====
# Generate with: openssl rand -base64 32
# Never commit a real value.
FIELD_ENCRYPTION_KEY=

# ==== Auth / Sessions ====
AUTH_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_NAME=baddies_session
SESSION_TTL_SECONDS=2592000

# ==== Verification Provider ====
VERIFICATION_PROVIDER=stub
VERIFICATION_PROVIDER_API_KEY=
VERIFICATION_PROVIDER_WEBHOOK_SECRET=

# ==== Payment Provider ====
PAYMENT_PROVIDER=stub
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ==== Object Storage / Media ====
MEDIA_STORAGE_PROVIDER=stub
MEDIA_STORAGE_BUCKET=baddies-media-dev
MEDIA_SIGNED_URL_TTL_SECONDS=300

# ==== Business Configuration ====
DEFAULT_ENTRY_PRICE_USD=2.99
DEFAULT_VIP_PRICE_USD=9.99
DEFAULT_UNLIMITED_PRICE_USD=19.99
DEFAULT_CREATOR_SHARE=0.80
DEFAULT_PLATFORM_SHARE=0.20
