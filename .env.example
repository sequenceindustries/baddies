# ==== Core ====
NODE_ENV=development
APP_URL=http://localhost:3000

# ==== Database ====
DATABASE_URL=postgresql://baddies:baddies@localhost:5432/baddies_dev

# ==== Field-level encryption ====
# Generate with: openssl rand -base64 32
# Never commit a real value.
FIELD_ENCRYPTION_KEY=

# ==== Auth / Sessions ====
AUTH_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_NAME=baddies_session
SESSION_TTL_SECONDS=2592000

# ==== Verification Provider ====
VERIFICATION_PROVIDER=stub
VERIFICATION_PROVIDER_API_KEY=
VERIFICATION_PROVIDER_WEBHOOK_SECRET=

# ==== Payment Provider ====
PAYMENT_PROVIDER=stub
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ==== Object Storage / Media ====
MEDIA_STORAGE_PROVIDER=stub
MEDIA_STORAGE_BUCKET=baddies-media-dev
MEDIA_SIGNED_URL_TTL_SECONDS=300

# ==== Notification Provider ====
# "stub" (default) logs instead of sending — see
# src/lib/providers/notification/. Set to "resend" to send real email.
NOTIFICATION_PROVIDER=stub
RESEND_API_KEY=
# Defaults to Resend's shared sandbox sender if unset (no DNS setup
# needed); swap to a verified @baddies.africa address once that domain
# is set up in Resend.
RESEND_FROM_EMAIL=
# Who gets emailed when someone submits the Founding Baddies form
# (src/app/api/founding/apply/route.ts). No email is sent if unset.
FOUNDING_APPLICATION_NOTIFY_EMAIL=

# ==== WhatsApp Provider ====
# "stub" (default) is the only implementation in V1 — no paid WhatsApp
# Business API integration yet (see src/lib/providers/whatsapp/). It
# builds a plain click-to-chat link to BADDIES_WHATSAPP_NUMBER; an admin
# manually confirms once the applicant's message arrives.
WHATSAPP_PROVIDER=stub
# International format, digits only get used (e.g. "+27821234567"). Unset
# = the WhatsApp verification step has nowhere to point applicants yet.
BADDIES_WHATSAPP_NUMBER=

# ==== Google Sign-In ====
# "Continue with Google" on /login and /register — src/lib/auth/google.ts.
# Both unset = the buttons hide themselves entirely (see
# GET /api/auth/google/start's own comment), so this is safe to leave
# blank until real credentials exist. To get real values: Google Cloud
# Console -> APIs & Services -> Credentials -> Create OAuth client ID
# (Web application). Add these as Authorized redirect URIs, exactly:
#   {APP_URL}/api/auth/google/callback   (e.g. https://baddies.africa/api/auth/google/callback)
#   http://localhost:3000/api/auth/google/callback   (for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==== Geo lock (creator applications) ====
# South African creators only, no exceptions — see src/lib/security/geo.ts.
# Outside production this always resolves to South Africa so local dev
# and tests aren't blocked. Set to "false" to actually exercise the real
# lock (IP geolocation) against a local/non-production server.
GEO_LOCK_DISABLED=

# ==== Business Configuration ====
# Informational only — none of these are actually read from the
# environment. Real defaults live in src/lib/config/business.ts and are
# seeded into the platform_settings table (see prisma/seed.ts), which is
# the only place pricing/revenue-share is read from at runtime — that's
# what lets them change without a redeploy (build brief §32).
#   VVIP (Exclusive subscription): fixed $9.99 for every creator — not
#   read from here or from platform_settings, see EXCLUSIVE_PRICE_USD in
#   src/lib/creator/pricing.ts.
#   VIP pass (platform-wide, one price for every participating creator): $19.99
#   Creator / platform revenue split: 80% / 20%
